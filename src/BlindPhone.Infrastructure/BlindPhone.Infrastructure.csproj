<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BlindPhone.Infrastructure: impostazioni, credenziali, scorciatoie globali,
    persistenza.

    Richiede Windows: DPAPI per la protezione delle credenziali (ANALISI 15.1) e
    RegisterHotKey per le scorciatoie che devono funzionare anche con
    l'applicazione in secondo piano (ANALISI 10.1).
  -->

  <PropertyGroup>
    <TargetFramework>$(BandaDotNet)-windows</TargetFramework>
    <RootNamespace>BlindPhone.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlindPhone.Core\BlindPhone.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(BandaPacchetti)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="$(BandaPacchetti)" />
  </ItemGroup>

</Project>
