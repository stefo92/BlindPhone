<Window x:Class="BlindPhone.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlindPhone - aggiornamento disponibile"
        Width="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">

    <!--
        FINESTRA DELL'AGGIORNAMENTO

        Dice tre cose in quest'ordine: che versione c'e' adesso e quale arriva, cosa
        porta di nuovo, e da dove viene. La terza non e' un dettaglio tecnico messo
        li' per completezza: chi sta per installare un programma con i privilegi di
        amministratore deve sapere se sta arrivando da un canale cifrato o no.

        L'elenco delle novita' e' una casella di sola lettura e non un'etichetta: il
        cursore ci si muove riga per riga con le frecce e lo screen reader legge
        quello su cui passa. E' la stessa scelta dell'avviso di versione beta e della
        guida in linea.

        Il pulsante predefinito e' "Piu' tardi" e non "Installa". Un aggiornamento non
        e' un'emergenza, la finestra puo' comparire mentre squilla il telefono, e un
        Invio dato per chiudere qualcosa non deve far partire un'installazione che
        chiude l'applicazione.
    -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   FontWeight="Bold"
                   FontSize="20"
                   Margin="0,0,0,4"
                   Text="Aggiornamento disponibile"
                   AutomationProperties.Name="Aggiornamento disponibile"
                   AutomationProperties.LiveSetting="Polite" />

        <TextBlock Grid.Row="1"
                   x:Name="VersionText"
                   FontSize="16"
                   Margin="0,0,0,12"
                   Text=""
                   AutomationProperties.Name="Versione installata e versione disponibile" />

        <TextBox Grid.Row="2"
                 x:Name="NotesText"
                 Height="220"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="16"
                 Text=""
                 AutomationProperties.Name="Novità introdotte da questa versione"
                 AutomationProperties.HelpText="Frecce su e giu' per leggere riga per riga." />

        <TextBlock Grid.Row="3"
                   x:Name="ChannelText"
                   FontSize="14"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text=""
                   AutomationProperties.Name="Provenienza del pacchetto" />

        <!--
            Avanzamento dello scaricamento. La barra e' accompagnata da una riga di
            testo con la percentuale: una barra che avanza non dice niente a chi non
            la vede, e la riga e' anche cio' che lo screen reader puo' leggere a
            richiesta.
        -->
        <StackPanel Grid.Row="4" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <ProgressBar x:Name="DownloadProgress"
                         Height="18"
                         Minimum="0"
                         Maximum="100"
                         AutomationProperties.Name="Avanzamento dello scaricamento" />

            <TextBlock x:Name="ProgressText"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Text=""
                       AutomationProperties.Name="Stato dello scaricamento"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="InstallButton"
                    Content="_Scarica e installa"
                    MinWidth="220"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Scarica e installa l'aggiornamento"
                    AutomationProperties.HelpText="Scarica il pacchetto, ne verifica l'integrità e avvia l'installazione. BlindPhone verrà chiuso: nessuna chiamata deve essere in corso."
                    Click="OnInstallClick" />

            <Button x:Name="LaterButton"
                    Content="Più _tardi"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.Name="Chiudi e aggiorna più tardi"
                    Click="OnLaterClick" />
        </StackPanel>
    </Grid>
</Window>
