<Window x:Class="BlindPhone.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlindPhone - aggiornamento disponibile"
        Width="760"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">

    <!--
        FINESTRA DELL'AGGIORNAMENTO

        Dice tre cose in quest'ordine: che versione c'e' adesso e quale arriva, cosa
        porta di nuovo, e da dove viene. La terza non e' un dettaglio tecnico messo
        li' per completezza: chi sta per installare un programma con i privilegi di
        amministratore deve sapere se sta arrivando da un canale cifrato o no.

        L'elenco delle novita' e' una casella di sola lettura e non un'etichetta: il
        cursore ci si muove riga per riga con le frecce e lo screen reader legge
        quello su cui passa. E' la stessa scelta dell'avviso di versione beta e della
        guida in linea.

        LA FINESTRA SI APRE CON IL CURSORE SULLE NOVITA', e non su un pulsante. Prima
        il fuoco andava a un pulsante: lo screen reader leggeva il titolo e il
        pulsante, e le novita' - cioe' la ragione per cui la finestra esiste - si
        raggiungevano soltanto con un Tab che nessuno annunciava abbastanza. La
        casella non accetta Invio, cosi' Invio arriva al pulsante predefinito anche
        da li'.

        NIENTE NOME FISSO SULLE RIGHE DI TESTO. Versione e provenienza avevano un nome
        accessibile scritto a mano, «Versione installata e versione disponibile», che
        copriva il testo: lo screen reader diceva l'etichetta e non le versioni.
        Senza, legge quello che c'e' scritto.

        TRE PULSANTI, E INVIO NON CHIUDE BLINDPHONE. «Scarica e installa ora» scarica
        e avvia l'installazione, che chiude l'applicazione. «Scarica e installa
        successivamente» scarica in sottofondo e chiede di installare al prossimo
        avvio. «Annulla» non fa niente, e l'aggiornamento torna al prossimo avvio.
        Il predefinito, cioe' Invio, e' il secondo: la finestra puo' comparire
        mentre squilla il telefono, e un Invio dato per togliersela di torno non deve
        far partire un'installazione che chiude l'applicazione con una chiamata in
        corso. Esc e' «Annulla».

        LA STESSA FINESTRA FA LA DOMANDA DEL RIAVVIO. Quando il pacchetto e' gia'
        scaricato, il codice cambia titolo e pulsanti: «Si', installa adesso» e «No,
        piu' tardi», e il secondo prende Invio ed Esc. Una seconda finestra con lo
        stesso aspetto sarebbe una copia da tenere allineata.
    -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   FontWeight="Bold"
                   FontSize="20"
                   Margin="0,0,0,4"
                   Text="Aggiornamento disponibile"
                   AutomationProperties.Name="Aggiornamento disponibile"
                   AutomationProperties.LiveSetting="Polite" />

        <TextBlock Grid.Row="1"
                   x:Name="VersionText"
                   FontSize="16"
                   Margin="0,0,0,12"
                   Text="" />

        <TextBox Grid.Row="2"
                 x:Name="NotesText"
                 Height="220"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="16"
                 Text=""
                 AutomationProperties.Name="Novità introdotte da questa versione"
                 AutomationProperties.HelpText="Frecce su e giu' per leggere riga per riga." />

        <TextBlock Grid.Row="3"
                   x:Name="ChannelText"
                   FontSize="14"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="" />

        <!--
            Avanzamento dello scaricamento. La barra e' accompagnata da una riga di
            testo con la percentuale: una barra che avanza non dice niente a chi non
            la vede, e la riga e' anche cio' che lo screen reader puo' leggere a
            richiesta.
        -->
        <StackPanel Grid.Row="4" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <ProgressBar x:Name="DownloadProgress"
                         Height="18"
                         Minimum="0"
                         Maximum="100"
                         AutomationProperties.Name="Avanzamento dello scaricamento" />

            <TextBlock x:Name="ProgressText"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Text=""
                       AutomationProperties.Name="Stato dello scaricamento"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <WrapPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="InstallNowButton"
                    Content="Scarica e installa _ora"
                    MinWidth="200"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Scarica e installa ora"
                    AutomationProperties.HelpText="Scarica il pacchetto, ne verifica l'integrità e avvia subito l'installazione. BlindPhone verrà chiuso: nessuna chiamata deve essere in corso."
                    Click="OnInstallNowClick" />

            <Button x:Name="InstallLaterButton"
                    Content="Scarica e installa _successivamente"
                    MinWidth="260"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    AutomationProperties.Name="Scarica e installa successivamente"
                    AutomationProperties.HelpText="Scarica il pacchetto in sottofondo mentre continui a lavorare. Al prossimo avvio di BlindPhone ti chiede se installarlo."
                    Click="OnInstallLaterClick" />

            <Button x:Name="CancelButton"
                    Content="_Annulla"
                    MinWidth="110"
                    IsCancel="True"
                    AutomationProperties.Name="Annulla"
                    AutomationProperties.HelpText="Non scarica niente. L'aggiornamento ti verrà riproposto al prossimo avvio di BlindPhone."
                    Click="OnCancelClick" />
        </WrapPanel>
    </Grid>
</Window>
