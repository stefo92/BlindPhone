<Window x:Class="BlindPhone.App.BetaNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlindPhone - versione beta"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}">

    <!--
        AVVISO DI VERSIONE BETA

        OGGI NON VIENE MOSTRATO: l'interruttore e' App.AvvisoBetaAllAvvio. Quando e'
        acceso compare a ogni avvio, prima della finestra principale.

        Non ha una casella "non mostrare piu'": un avviso di responsabilita' che
        l'operatore puo' spegnere e' un avviso che dopo il primo giorno non esiste
        piu', e la condizione che descrive — software in prova su un posto
        telefonico di servizio — non smette di valere il secondo giorno. Mostrarlo o
        no e' una decisione di chi distribuisce il programma, e sta nel codice di
        avvio.

        Il costo per l'operatore e' una pressione di Invio: il pulsante di conferma
        e' quello predefinito e ha gia' il fuoco all'apertura, quindi chi conosce il
        programma parte senza nemmeno ascoltare fino in fondo.

        Il testo sta in una casella di sola lettura e non in un'etichetta: dentro
        una casella il cursore si muove riga per riga con le frecce, e lo screen
        reader legge quello su cui passa. E' la stessa scelta della guida in linea.
    -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   FontWeight="Bold"
                   FontSize="19"
                   Margin="0,0,0,12"
                   Text=""
                   AutomationProperties.Name="Versione di BlindPhone in uso" />

        <TextBox Grid.Row="1"
                 x:Name="NoticeText"
                 Height="260"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="16"
                 Text=""
                 AutomationProperties.Name="Avviso sulla versione beta e sulla responsabilità"
                 AutomationProperties.HelpText="Frecce su e giu' per leggere riga per riga. Invio accetta e avvia BlindPhone." />

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="Premi Invio per accettare e avviare BlindPhone, oppure Esc per chiudere senza avviarlo." />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="AcceptButton" Content="_Ho capito, avvia BlindPhone"
                    MinWidth="280" Margin="0,0,8,0"
                    IsDefault="True"
                    AutomationProperties.Name="Ho capito, avvia BlindPhone"
                    Click="OnAcceptClick" />

            <Button x:Name="QuitButton" Content="_Esci" IsCancel="True"
                    AutomationProperties.Name="Chiudi senza avviare BlindPhone"
                    Click="OnQuitClick" />
        </StackPanel>
    </Grid>
</Window>
