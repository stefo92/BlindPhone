<Window x:Class="BlindPhone.App.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rubrica"
        Height="620" Width="920"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <!--
        RUBRICA

        Il modello di interazione e' quello che un operatore non vedente usa
        davvero: si apre, si digita, si scende con la freccia, si preme Invio. Non
        c'e' un pulsante "cerca" perche' costringerebbe a un passaggio in piu' su
        un'operazione che si ripete centinaia di volte al giorno.

        La ricerca e' incrementale con un ritardo di 300 millisecondi: cercare a
        ogni tasto premuto produrrebbe un annuncio del conteggio a ogni lettera,
        che si sovrapporrebbe all'eco delle lettere stesse.

        L'elenco e' una DataGrid vera e non un ItemsControl travestito: lo screen
        reader annuncia "riga 3 di 12" e legge le intestazioni di colonna, cosa che
        un finto elenco non permette.
    -->

    <Window.Resources>
        <!--
            NOME ACCESSIBILE DELLA CELLA DEL NUMERO

            L'unica cella in cui il contenuto letterale non va bene: "4021" viene
            pronunciato "quattromilaventuno", che e' inutilizzabile per
            trascriverlo o ricomporlo. Il nome accessibile porta le stesse cifre
            separate da spazi, che lo screen reader legge una per una e che sulla
            riga braille restano quattro caratteri.

            Nelle altre colonne non si dichiara alcun nome: il valore predefinito
            e' gia' il contenuto della cella, ed e' esattamente cio' che si vuole
            sentire.

            IL NOME VA DICHIARATO IN DUE POSTI, cella e testo, con lo stesso valore.
            Una cella di DataGrid contiene un TextBlock che espone a sua volta il
            proprio testo come elemento di lettura: dichiarando il nome in uno solo dei
            due, i due nodi dicono cose diverse e lo screen reader le legge entrambe.
            E' il difetto per cui il numero veniva pronunciato due volte. La
            spiegazione per esteso, con le misure, sta in MainWindow.xaml.
        -->
        <Style x:Key="SpokenNumberCell" TargetType="DataGridCell">
            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenNumber}" />
        </Style>

        <Style x:Key="SpokenNumberText" TargetType="TextBlock">
            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenNumber}" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ricerca -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Target="{Binding ElementName=SearchBox}"
                   Content="_Cerca"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />

            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     FontSize="20"
                     AutomationProperties.Name="Campo di ricerca in rubrica"
                     AutomationProperties.HelpText="Digita nome, interno, reparto o padiglione. Freccia giu' per scendere nei risultati."
                     KeyDown="OnSearchKeyDown"
                     TextChanged="OnSearchTextChanged" />
        </Grid>

        <!-- Conteggio risultati, regione dinamica -->
        <TextBlock Grid.Row="1"
                   x:Name="ResultCountText"
                   Margin="0,8,0,8"
                   Text=""
                   AutomationProperties.Name="Numero di risultati trovati"
                   AutomationProperties.LiveSetting="Polite" />

        <!--
            RISULTATI

            E' una tabella vera, ed e' una scelta di accessibilita' non di stile.
            Lo screen reader la espone come griglia: le frecce verticali cambiano
            contatto, quelle orizzontali percorrono i campi, e ogni cella viene
            letta da sola. E' il modo in cui un operatore cerca davvero un
            nominativo, perche' gli permette di fermarsi appena ha sentito il campo
            che gli serve invece di aspettare la fine di una frase composta.

            Per questo il contenitore della riga NON dichiara un nome accessibile:
            una descrizione completa sulla riga verrebbe letta a ogni freccia,
            prima del contenuto della cella, e raddoppierebbe il tempo di ogni
            spostamento.
        -->
        <DataGrid Grid.Row="2"
                  x:Name="ResultsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AutomationProperties.Name="Tabella dei contatti trovati"
                  AutomationProperties.HelpText="Frecce su e giu' per cambiare contatto, destra e sinistra per leggere i campi. Invio chiama. Control Invio elenca gli altri recapiti. F9 usa come destinazione del trasferimento. Control D legge la scheda completa. Freccia su dal primo contatto torna al campo di ricerca."
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="False"
                  PreviewKeyDown="OnResultsPreviewKeyDown"
                  MouseDoubleClick="OnResultsDoubleClick">

            <!--
                Ordinamento, riordino e ridimensionamento sono disattivati di
                proposito: sono gesti che si attivano per sbaglio e che
                riorganizzano la tabella sotto le dita di chi non vede.

                La virtualizzazione delle righe e' spenta perche' i risultati sono
                al massimo cinquanta: costa nulla, e garantisce che la cella su cui
                portare il focus esista sempre.
            -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nominativo" Binding="{Binding Name}" Width="260" />
                <DataGridTextColumn Header="Numero" Binding="{Binding Number}" Width="110"
                                    CellStyle="{StaticResource SpokenNumberCell}"
                                    ElementStyle="{StaticResource SpokenNumberText}" />
                <!--
                    LE COLONNE SONO QUELLE CHE LA RUBRICA DELL'ENTE PORTA DAVVERO.

                    "Descrizione" viene subito dopo il numero perche' e' cio' che
                    identifica le voci senza nome, e in una rubrica ospedaliera sono la
                    maggioranza: ambulatori, sale, guardiole. "Struttura" e' sparita
                    perche' l'importazione da file non la riempie piu'.
                -->
                <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="260" />
                <DataGridTextColumn Header="Reparto" Binding="{Binding Department}" Width="200" />
                <DataGridTextColumn Header="Collocazione" Binding="{Binding Location}" Width="180" />
                <DataGridTextColumn Header="Relativo" Binding="{Binding RelatedTo}" Width="100"
                                    CellStyle="{StaticResource SpokenNumberCell}"
                                    ElementStyle="{StaticResource SpokenNumberText}" />
                <DataGridTextColumn Header="Stato" Binding="{Binding Presence}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <!--
            Dettaglio della voce selezionata.

            NON e' una regione dinamica, e non lo e' piu' da quando l'elenco e' una
            tabella: notificarne il cambiamento farebbe leggere la scheda completa a
            ogni freccia, subito dopo la cella, che e' esattamente il rumore che la
            navigazione per celle serve a togliere. Resta a schermo per chi la
            rilegge col cursore virtuale, e Control D la pronuncia a richiesta.
        -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8,6" BorderThickness="1"
                BorderBrush="{DynamicResource TextBrush}">
            <TextBlock x:Name="DetailText"
                       TextWrapping="Wrap"
                       Text="Digita per cercare un contatto."
                       AutomationProperties.Name="Scheda del contatto selezionato" />
        </Border>

        <!-- Comandi -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CallButton" Content="C_hiama" Margin="0,0,8,0" IsDefault="True"
                    AutomationProperties.Name="Chiama il contatto selezionato"
                    Click="OnCallClick" />
            <Button x:Name="TransferButton" Content="_Trasferisci qui" Margin="0,0,8,0"
                    AutomationProperties.Name="Usa il contatto selezionato come destinazione del trasferimento in corso"
                    Click="OnTransferClick" />
            <Button x:Name="CloseButton" Content="Chi_udi" IsCancel="True"
                    AutomationProperties.Name="Chiudi la rubrica"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
