<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TEMA SCURO.

        NON E' UN VEZZO. Il posto operatore di un ospedale copre anche il turno di
        notte, spesso in una stanza tenuta in penombra perche' ci dorme qualcuno
        accanto o perche' l'operatore ipovedente non tollera la luce forte. Uno
        schermo bianco a tutta luminosita' in quelle condizioni e' la prima cosa di
        cui ci si lamenta, e la risposta "abbassa la luminosita' del monitor" toglie
        contrasto proprio a chi ne ha piu' bisogno.

        NON SI USA IL NERO PIENO. Testo chiaro su nero assoluto produce l'alone che
        rende faticosa la lettura prolungata (halation), e chi ha un astigmatismo lo
        sente dopo pochi minuti. La tela sta su #1B1B1B e le schede salgono a #262626:
        la gerarchia si legge come nel tema chiaro, ribaltata.

        Le stesse chiavi del tema chiaro, con gli stessi rapporti di contrasto sopra
        il 7 a 1.
    -->

    <!-- Superfici: tela scura, schede appena piu' chiare. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="CardBrush" Color="#262626" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#4D4D4D" />

    <!-- Testo: 13,4 a 1 sulla scheda, 7,3 a 1 quello attenuato. -->
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B9B9B9" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#8C8C8C" />

    <!-- Evidenziazione: 7,4 a 1 sulla tela. Piu' chiara che nel tema chiaro, -->
    <!-- perche' qui deve staccarsi da uno sfondo scuro e non da uno chiaro.  -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5CADFF" />

    <!-- Controlli: la faccia dei pulsanti si stacca dalla scheda. -->
    <SolidColorBrush x:Key="ControlBrush" Color="#343434" />
    <SolidColorBrush x:Key="ControlTextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#2B2B2B" />

    <!-- Campi di immissione: piu' scuri della scheda, cosi' si vede dove si scrive. -->
    <SolidColorBrush x:Key="FieldBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#7A7A7A" />

    <!-- Selezione negli elenchi: bianco su blu, 7,6 a 1. -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#1F5FA8" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverRowBrush" Color="#2F3B47" />

    <!-- Intestazioni di tabella. -->
    <SolidColorBrush x:Key="HeaderBrush" Color="#2E2E2E" />

</ResourceDictionary>
