<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TEMA DI SISTEMA: i colori li sceglie Windows.

        E' IL TEMA CHE VINCE SEMPRE QUANDO IL CONTRASTO ELEVATO E' ATTIVO, e non e'
        una preferenza dell'utente ma un obbligo del prodotto. Chi usa il contrasto
        elevato lo ha configurato una volta in Windows — spesso su misura, per una
        ipovisione precisa — e si aspetta che ogni applicazione lo rispetti. Un tema
        scritto da noi, per quanto curato, sarebbe l'unica finestra della macchina a
        ignorare quella scelta.

        Vale anche per chi semplicemente preferisce che il programma segua il sistema.

        I colori sono agganciati con DynamicResource alle chiavi di SystemColors:
        cambiando tema in Windows a programma aperto, le finestre seguono senza
        riavviare.

        LE STESSE CHIAVI DEGLI ALTRI DUE TEMI. Dove Windows non offre un equivalente
        — il filo delle schede, la faccia attenuata dei controlli — si ricade sulla
        chiave di sistema piu' vicina invece di inventare un colore: in contrasto
        elevato un colore inventato e' esattamente cio' che rompe la configurazione
        dell'utente.
    -->

    <!-- Superfici. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />

    <!-- Testo. -->
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />

    <!-- Evidenziazione. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />

    <!-- Controlli. -->
    <SolidColorBrush x:Key="ControlBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ControlTextBrush" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />

    <!-- Campi di immissione. -->
    <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />

    <!-- Selezione negli elenchi. -->
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="HoverRowBrush" Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}" />

    <!-- Intestazioni di tabella. -->
    <SolidColorBrush x:Key="HeaderBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />

    <!--
        Fascia di stato della chiamata. I QUATTRO STATI DI AVVISO INVERTONO TESTO E
        FONDO DELLA FINESTRA, e hanno tutti lo stesso aspetto.

        Il colore evidenziato di Windows sarebbe stato il candidato naturale, ma con i
        colori predefiniti il bianco sull'azzurro di sistema sta a 4,5 a 1, sotto il 7 a
        1 di questo prodotto. La coppia testo-finestra invece e' quella su cui chi usa il
        contrasto elevato ha regolato tutto il resto: rovesciata, si stacca dalla scheda
        e tiene esattamente il contrasto che l'utente ha scelto. A distinguere gli stati
        resta la parola, che e' quello che deve fare in ogni tema.
    -->
    <SolidColorBrush x:Key="LineAlertTextBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="LineRingingBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="LineTalkingBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="LineHoldBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="LineOutOfServiceBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

</ResourceDictionary>
