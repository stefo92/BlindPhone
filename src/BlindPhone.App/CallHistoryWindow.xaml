<!--
    ShowInTaskbar="True" NON E' UN DETTAGLIO ESTETICO: DECIDE ALT+TAB.

    Una finestra di proprieta' di un'altra compare nell'elenco di ALT+TAB solo se
    porta lo stile esteso WS_EX_APPWINDOW, e WPF glielo mette quando ShowInTaskbar
    e' vero. Con il valore predefinito dei dialoghi - falso - questa finestra
    spariva da ALT+TAB e dalla barra delle applicazioni: chi la lasciava, anche solo
    perche' una chiamata entrante ha portato avanti la finestra principale, non
    aveva piu' modo di tornarci se non chiudendo e riaprendo.

    Per chi non vede lo schermo e' un vicolo cieco: la finestra c'e', ha il fuoco
    da qualche parte, ma nessun gesto di sistema la raggiunge.

    Misurato: senza, TOOLWINDOW=False e APPWINDOW=False, quindi fuori da ALT+TAB.
    Vedi FinestreInAltTabTests.
-->
<Window x:Class="BlindPhone.App.CallHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultime chiamate"
        Height="640" Width="940"
        MinHeight="440" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <!--
        ULTIME CHIAMATE

        Tre pannelli e non un elenco unico con una colonna "tipo". Le tre domande che
        l'operatore si fa sono diverse fra loro — "chi mi ha cercato?", "chi ho
        chiamato?", "chi ho perso?" — e la terza e' quella urgente: doverla estrarre
        da un elenco misto, riga per riga con la sintesi, costerebbe il tempo che
        serve a richiamare.

        Le schede si percorrono con Control Tab e lo screen reader annuncia "scheda 3
        di 3". Le perse sono la prima scheda di proposito: e' la ragione principale
        per cui questa finestra si apre.

        Ogni elenco e' una tabella vera, come la rubrica e per lo stesso motivo: le
        frecce verticali cambiano chiamata, quelle orizzontali percorrono i campi, e
        ogni cella viene letta da sola.
    -->

    <Window.Resources>
        <!--
            Il numero va letto cifra per cifra: "4021" pronunciato
            "quattromilaventuno" e' inutilizzabile per richiamare o trascrivere.
        -->
        <Style x:Key="SpokenNumberCell" TargetType="DataGridCell">
            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenNumber}" />
        </Style>

        <!-- Il momento della chiamata, in forma discorsiva: "oggi alle 9 e 40". -->
        <Style x:Key="SpokenWhenCell" TargetType="DataGridCell">
            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenWhen}" />
        </Style>

        <!--
            GLI STESSI NOMI, DICHIARATI ANCHE SUL TESTO DENTRO LA CELLA.

            Una cella di DataGrid contiene un TextBlock che espone a sua volta il
            proprio testo come elemento di lettura a se'. Dichiarando il nome sulla
            sola cella, i due nodi annidati dicono cose diverse e lo screen reader le
            legge entrambe: e' il difetto per cui il numero e l'orario venivano
            pronunciati due volte. La spiegazione per esteso, con le misure
            sull'albero di automazione, sta in MainWindow.xaml.
        -->
        <Style x:Key="SpokenNumberText" TargetType="TextBlock">
            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenNumber}" />
        </Style>

        <Style x:Key="SpokenWhenText" TargetType="TextBlock">
            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenWhen}" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   Text="Control Tab cambia pannello. Frecce su e giu' per scorrere, destra e sinistra per leggere i campi. Invio richiama, F9 usa il numero come destinazione del trasferimento in corso." />

        <TabControl Grid.Row="1"
                    x:Name="Tabs"
                    AutomationProperties.Name="Tipi di chiamata"
                    SelectionChanged="OnTabChanged">

            <TabItem x:Name="MissedTab" Header="_Perse" AutomationProperties.Name="Chiamate perse">
                <DataGrid x:Name="MissedGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AutomationProperties.Name="Tabella delle chiamate perse"
                          AutomationProperties.HelpText="Chiamate ricevute e non risposte. Invio richiama il numero."
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="False"
                          PreviewKeyDown="OnGridPreviewKeyDown"
                          MouseDoubleClick="OnGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="180"
                                            CellStyle="{StaticResource SpokenWhenCell}"
                                            ElementStyle="{StaticResource SpokenWhenText}" />
                        <DataGridTextColumn Header="Chi" Binding="{Binding Who}" Width="*" />
                        <DataGridTextColumn Header="Numero" Binding="{Binding Number}" Width="150"
                                            CellStyle="{StaticResource SpokenNumberCell}"
                                            ElementStyle="{StaticResource SpokenNumberText}" />
                        <DataGridTextColumn Header="Coda" Binding="{Binding Queue}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="IncomingTab" Header="_Ricevute" AutomationProperties.Name="Chiamate ricevute">
                <DataGrid x:Name="IncomingGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AutomationProperties.Name="Tabella delle chiamate ricevute"
                          AutomationProperties.HelpText="Chiamate ricevute e risposte, con la durata della conversazione."
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="False"
                          PreviewKeyDown="OnGridPreviewKeyDown"
                          MouseDoubleClick="OnGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="180"
                                            CellStyle="{StaticResource SpokenWhenCell}"
                                            ElementStyle="{StaticResource SpokenWhenText}" />
                        <DataGridTextColumn Header="Chi" Binding="{Binding Who}" Width="*" />
                        <DataGridTextColumn Header="Numero" Binding="{Binding Number}" Width="150"
                                            CellStyle="{StaticResource SpokenNumberCell}"
                                            ElementStyle="{StaticResource SpokenNumberText}" />
                        <DataGridTextColumn Header="Durata" Binding="{Binding Duration}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="OutgoingTab" Header="_Effettuate" AutomationProperties.Name="Chiamate effettuate">
                <DataGrid x:Name="OutgoingGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AutomationProperties.Name="Tabella delle chiamate effettuate"
                          AutomationProperties.HelpText="Chiamate partite da questa postazione, con l'esito."
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="False"
                          PreviewKeyDown="OnGridPreviewKeyDown"
                          MouseDoubleClick="OnGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="180"
                                            CellStyle="{StaticResource SpokenWhenCell}"
                                            ElementStyle="{StaticResource SpokenWhenText}" />
                        <DataGridTextColumn Header="Chi" Binding="{Binding Who}" Width="*" />
                        <DataGridTextColumn Header="Numero" Binding="{Binding Number}" Width="150"
                                            CellStyle="{StaticResource SpokenNumberCell}"
                                            ElementStyle="{StaticResource SpokenNumberText}" />
                        <DataGridTextColumn Header="Esito" Binding="{Binding Outcome}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   x:Name="SummaryText"
                   Margin="0,10,0,0"
                   Text=""
                   AutomationProperties.Name="Riepilogo dell'elenco"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!--
                Il pulsante c'e' anche per chi usa il mouse, ma la ragione per cui
                esiste e' un'altra: senza, un pannello fermo a cinquanta voci non
                dichiara da nessuna parte che sotto ce ne sono altre.
            -->
            <Button x:Name="ShowMoreButton" Content="Mostra le precedenti"
                    MinWidth="200" Margin="0,0,8,0"
                    AutomationProperties.Name="Mostra altre cinquanta chiamate in questo pannello"
                    Click="OnShowMoreClick" />

            <Button x:Name="CallBackButton" Content="Ric_hiama"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Richiama il numero della chiamata selezionata"
                    Click="OnCallBackClick" />

            <Button x:Name="ClearButton" Content="S_vuota l'elenco..."
                    MinWidth="200" Margin="0,0,8,0"
                    AutomationProperties.Name="Elimina le chiamate dall'elenco"
                    AutomationProperties.HelpText="Si puo' svuotare il solo pannello aperto oppure tutto l'elenco."
                    Click="OnClearClick" />

            <Button x:Name="CloseButton" Content="_Chiudi" IsCancel="True"
                    AutomationProperties.Name="Chiudi l'elenco delle chiamate"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
