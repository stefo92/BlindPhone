<Window x:Class="BlindPhone.App.SipAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlindPhone - account SIP"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">

    <!--
        ELENCO DEGLI ACCOUNT SIP

        Serve a due gesti diversi che qui convivono senza confondersi: guardare
        quali account esistono, e passare da uno all'altro in fretta.

        E' una tabella e non un elenco di righe composte, per lo stesso motivo per
        cui lo sono la rubrica e le ultime chiamate: lo screen reader legge la
        cella su cui si trova il cursore, quindi l'operatore si ferma appena ha
        sentito quello che gli serve invece di ascoltare l'intera riga.

        Le colonne sono nell'ordine in cui servono a decidere: nome, interno,
        centralino, se e' quello attivo adesso, se e' il predefinito all'avvio.
        "Attivo" e "predefinito" sono due cose diverse e vanno tenute distinte —
        si puo' lavorare su un account senza averlo reso predefinito.

        Invio attiva l'account su cui ci si trova. Non c'e' un pulsante "applica":
        e' l'operazione per cui questa finestra esiste, e chiedere due gesti per
        farla sarebbe come mettere un pulsante "cerca" nella rubrica.

        SELEZIONE PER RIGA, come in ogni altra tabella del prodotto.

        Qui c'era SelectionUnit="Cell", ed e' il difetto per cui questa finestra si
        apriva nera emettendo un suono ripetuto. Con la selezione per cella la
        DataGrid rifiuta che venga selezionata una RIGA, e solleva l'eccezione
        mentre sta calcolando il proprio layout: la finestra non arrivava mai a
        disegnarsi, il gestore degli errori annunciava il guasto con il suo segnale
        acustico, il layout ci riprovava, e da li' il ciclo. Sul registro la stessa
        eccezione compare milleduecentoventi volte in pochi secondi.

        La lettura cella per cella con le frecce orizzontali non si perde: dipende
        dalla cella corrente, non dall'unita' di selezione.
    -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   FontSize="16"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text=""
                   AutomationProperties.Name="Account SIP configurati" />

        <DataGrid Grid.Row="1"
                  x:Name="AccountsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  GridLinesVisibility="Horizontal"
                  FontSize="15"
                  AutomationProperties.Name="Elenco degli account SIP"
                  AutomationProperties.HelpText="Frecce su e giu' per cambiare account, destra e sinistra per leggere i campi. Barra spaziatrice per scegliere l'account su cui agiranno i pulsanti. Invio per attivarlo subito."
                  SelectionChanged="OnSelectionChanged"
                  PreviewKeyDown="OnGridKeyDown">
            <DataGrid.Columns>
                <!--
                    COLONNA DELLA SCELTA, prima di tutte.

                    E' l'unica colonna che non descrive l'account ma dice su quale
                    agiranno i pulsanti, ed e' per questo che sta all'inizio: quando
                    l'operatore percorre le righe con le frecce, la prima cosa che
                    sente e' se quella e' la riga scelta. Sentirlo per ultimo, dopo
                    cinque campi, significherebbe scoprirlo quando la decisione e'
                    gia' presa.

                    Una casella di controllo e non la parola "si": qui non si descrive
                    uno stato dell'account, si mostra una scelta che l'operatore puo'
                    cambiare. Lo screen reader la annuncia come "casella di controllo,
                    selezionata", che e' esattamente cio' che e', e la barra
                    spaziatrice e' il gesto che tutti si aspettano su una casella.

                    La griglia e' di sola lettura, quindi la casella non si modifica
                    con il mouse: la scelta passa sempre dalla barra spaziatrice o
                    dalle frecce, cioe' da un gesto che produce anche un annuncio.
                -->
                <DataGridCheckBoxColumn Header="Scelto" Binding="{Binding IsChosen}" Width="70" />

                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.4*" />
                <DataGridTextColumn Header="Interno" Binding="{Binding Username}" Width="0.8*" />
                <DataGridTextColumn Header="Centralino" Binding="{Binding Domain}" Width="1.4*" />
                <DataGridTextColumn Header="Trasporto" Binding="{Binding Transport}" Width="0.8*" />
                <DataGridTextColumn Header="In uso" Binding="{Binding ActiveText}" Width="0.7*" />
                <DataGridTextColumn Header="All'avvio" Binding="{Binding DefaultText}" Width="0.8*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Text=""
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Esito dell'ultima operazione" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ActivateButton" Content="_Attiva questo account"
                    MinWidth="200" Margin="0,0,8,0"
                    AutomationProperties.Name="Attiva l'account selezionato adesso"
                    Click="OnActivateClick" />

            <Button x:Name="DefaultButton" Content="Usa _all'avvio"
                    MinWidth="160" Margin="0,0,8,0"
                    AutomationProperties.Name="Rendi predefinito l'account selezionato"
                    Click="OnDefaultClick" />

            <Button x:Name="SettingsButton" Content="_Modifica in Impostazioni"
                    MinWidth="210" Margin="0,0,8,0"
                    AutomationProperties.Name="Apri le impostazioni per modificare gli account"
                    Click="OnSettingsClick" />

            <Button x:Name="CloseButton" Content="_Chiudi" IsCancel="True"
                    MinWidth="100"
                    AutomationProperties.Name="Chiudi l'elenco"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
