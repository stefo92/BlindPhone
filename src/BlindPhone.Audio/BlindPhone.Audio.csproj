<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BlindPhone.Audio: instradamento audio a quattro vie su WASAPI (NAudio).

    Le quattro vie (microfono, conversazione, suoneria, annunci vocali) sono il
    differenziale accessibile del prodotto: separare la voce degli annunci
    dall'audio della conversazione risolve la sovrapposizione fra screen reader e
    interlocutore. Vedi ANALISI-BLINDPHONE.md 8.1.
  -->

  <PropertyGroup>
    <TargetFramework>$(BandaDotNet)-windows</TargetFramework>
    <RootNamespace>BlindPhone.Audio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlindPhone.Core\BlindPhone.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      CS0618: WasapiOut e WasapiCapture sono dichiarati obsoleti da NAudio 3.0, che
      propone WasapiPlayerBuilder e WasapiRecorderBuilder. Continuano a funzionare, e
      la sostituzione NON e' un rinominare: cambia il modo in cui riproduzione e
      cattura vengono create e configurate, cioe' il percorso su cui passa la voce in
      conversazione. E' una seconda migrazione, con una sua verifica in reparto, e
      farla di straforo dentro questa avrebbe reso impossibile capire da dove viene
      un eventuale difetto.

      L'avviso viene silenziato qui e non nei sette punti d'uso perche' la decisione
      e' una sola e va letta in un posto solo. Se cade, cadono tutti insieme, ed e'
      il momento in cui si affronta quella migrazione.

      Vedi docs\MIGRAZIONE-NAUDIO-3.md, sezione sul lavoro che resta.
    -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      I collaudi della catena audio vivono in BlindPhone.Windows.Tests: NAudio
      richiede Windows. Servono a StereoToneProvider, che e' un dettaglio interno del
      lettore di earcon ma anche uno dei tre punti in cui una conversione sbagliata
      degli indici si sente invece di comparire come errore.
    -->
    <InternalsVisibleTo Include="BlindPhone.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(BandaPacchetti)" />
    <!--
      NAudio 3.0 ha diviso il pacchetto: WASAPI e MediaFoundation non arrivano piu'
      con quello principale e vanno chiesti a parte. Senza NAudio.Wasapi mancano
      MMDevice, DataFlow, WasapiOut, WasapiCapture e la codifica delle
      registrazioni - trentaquattro errori di compilazione su trentotto.
    -->
    <PackageReference Include="NAudio" Version="3.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.0" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
